# /etc/frontierx/api.env template for the current lean profile.
# Keep this file readable only by the service administrator. The current API
# does not require a server signing secret, but this path should remain private
# because future runtime settings may.

NODE_ENV=production
HOST=127.0.0.1
PORT=8080

DB_PATH=/var/lib/frontierx/frontierx.db
FILE_BLOB_DIR=/var/lib/frontierx/blobs

# Values are bytes. The blob cap includes room for encrypted file framing.
FILE_MAX_BYTES=26214400
FILE_BLOB_MAX_BYTES=27262976
TEMP_BACKUP_QUOTA_BYTES=1073741824
STICKER_GIF_QUOTA_BYTES=134217728
