# FrontierX's current SQLite/filesystem runtime configuration.
# Node does not automatically parse this file. For production, use it as the
# source for /etc/frontierx/api.env (see deploy/lite/README.md). Never commit a
# real environment file.

# The API should remain loopback-only; Caddy owns public HTTPS and WebSockets.
NODE_ENV=production
HOST=127.0.0.1
PORT=8080

# Durable data lives outside the deployed release tree.
DB_PATH=/var/lib/frontierx/frontierx.db
FILE_BLOB_DIR=/var/lib/frontierx/blobs

# Conservative limits for a 2 vCPU / 2 GiB RAM / 30 GiB disk starter VPS.
# Values are bytes. FILE_BLOB_MAX_BYTES allows encrypted framing overhead.
FILE_MAX_BYTES=26214400
FILE_BLOB_MAX_BYTES=27262976
TEMP_BACKUP_QUOTA_BYTES=1073741824
STICKER_GIF_QUOTA_BYTES=134217728
